  if(usage_position EQUAL -1)
    message(FATAL_ERROR "Help does not describe the token command.")
  endif()
  string(FIND "${output}" "minic --ast <file>" ast_usage_position)
  if(ast_usage_position EQUAL -1)
    message(FATAL_ERROR "Help does not describe the AST command.")
  endif()
  string(FIND "${output}" "minic --resolve <file>" resolve_usage_position)
  if(resolve_usage_position EQUAL -1)
    message(FATAL_ERROR "Help does not describe the resolution command.")
  endif()
  string(FIND "${output}" "minic --check <file>" check_usage_position)
  if(check_usage_position EQUAL -1)
    message(FATAL_ERROR "Help does not describe the type-check command.")
  endif()
  string(FIND "${output}" "minic --bytecode <file>" bytecode_usage_position)
  if(bytecode_usage_position EQUAL -1)
    message(FATAL_ERROR "Help does not describe the bytecode command.")
  endif()
  string(FIND "${output}" "minic --run <file>" run_usage_position)
  if(run_usage_position EQUAL -1)
    message(FATAL_ERROR "Help does not describe the execution command.")
  endif()
  string(FIND "${output}" "minic --run-vm <file>" vm_usage_position)
  if(vm_usage_position EQUAL -1)
    message(FATAL_ERROR "Help does not describe the VM execution command.")
  endif()
  string(FIND "${output}" "minic --bytecode-opt <file>" optimized_bytecode_usage_position)
  if(optimized_bytecode_usage_position EQUAL -1)
    message(FATAL_ERROR "Help does not describe optimized disassembly.")
  endif()
  string(FIND "${output}" "minic --run-vm-opt <file>" optimized_vm_usage_position)
  if(optimized_vm_usage_position EQUAL -1)
    message(FATAL_ERROR "Help does not describe optimized VM execution.")
  endif()
elseif(NOT "${output}" STREQUAL "${expected_output}")
  message(FATAL_ERROR "Expected stdout:\n${expected_output}\nReceived stdout:\n${output}")
endif()
