file(MAKE_DIRECTORY "${WORK_DIR}")
set(input "${WORK_DIR}/${CASE}.mc")
set(expected_exit 0)
set(expected_error "")

if(CASE STREQUAL "hello")
  set(input "${SOURCE_DIR}/examples/hello.mc")
  file(READ "${SOURCE_DIR}/tests/hello.tokens" expected_output)
elseif(CASE STREQUAL "language")
  set(input "${SOURCE_DIR}/examples/lexer.mc")
  file(READ "${SOURCE_DIR}/tests/lexer.tokens" expected_output)
elseif(CASE STREQUAL "help")
  set(arguments --help)
elseif(CASE STREQUAL "empty")
  file(WRITE "${input}" "")
  set(expected_output "1:1 EOF \"\"\n")
elseif(CASE STREQUAL "keywords")
  file(WRITE "${input}" "bool void if else while true false")
  set(expected_output [=[1:1 BOOL "bool"
1:6 VOID "void"
1:11 IF "if"
1:14 ELSE "else"
1:19 WHILE "while"
1:25 TRUE "true"
1:30 FALSE "false"
1:35 EOF ""
]=])
elseif(CASE STREQUAL "missing_file")
  file(REMOVE "${input}")
  set(expected_exit 1)
  set(expected_output "")
  set(expected_error "${input}: error: Cannot open file.\n")
elseif(CASE STREQUAL "invalid_character")
  file(WRITE "${input}" "int main() {\n  @\n}\n")
  set(expected_exit 1)
  set(expected_output "")
  set(expected_error "${input}:2:3: error: Unexpected character \"@\".\n")
elseif(CASE STREQUAL "unterminated_comment")
  file(WRITE "${input}" "\n  /* unfinished\n")
  set(expected_exit 1)
  set(expected_output "")
  set(expected_error "${input}:2:3: error: Unterminated block comment.\n")
elseif(CASE STREQUAL "invalid_logical")
  file(WRITE "${input}" "bool ok = true;\n  ok = ok && false | true;\n")
  set(expected_exit 1)
  set(expected_output "")
  set(expected_error "${input}:2:20: error: Unexpected character \"|\".\n")
elseif(CASE STREQUAL "missing_argument")
  set(arguments --tokens)
  set(expected_exit 1)
  set(expected_output "")
  set(expected_error "minic: error: Expected --tokens <file>. Use --help for usage.\n")
elseif(CASE STREQUAL "check_hello" OR CASE STREQUAL "check_scopes" OR CASE STREQUAL "check_recursion"
       OR CASE STREQUAL "check_calls" OR CASE STREQUAL "check_control_flow" OR CASE STREQUAL "check_lexer"
       OR CASE STREQUAL "check_types")
  string(REGEX REPLACE "^check_" "" example "${CASE}")
  set(input "${SOURCE_DIR}/examples/${example}.mc")
  set(arguments --check "${input}")
  set(expected_output "")
elseif(CASE STREQUAL "check_type_error")
  set(input "${SOURCE_DIR}/examples/type_error.mc")
  set(arguments --check "${input}")
  set(expected_exit 1)
  set(expected_output "")
  set(expected_error "${input}:3:16: error: Expected type bool. Received int.\n")
elseif(CASE STREQUAL "check_empty")
  file(WRITE "${input}" "")
  set(arguments --check "${input}")
  set(expected_output "")
elseif(CASE STREQUAL "check_arity")
  file(WRITE "${input}" "void f(int x) {}\nvoid g() { f(); }\n")
  set(arguments --check "${input}")
  set(expected_exit 1)
  set(expected_output "")
  set(expected_error "${input}:2:12: error: Function \"f\" expects 1 argument. Received 0.\n")
elseif(CASE STREQUAL "check_return_path")
  file(WRITE "${input}" "int f(bool b) { if (b) return 1; }\n")
  set(arguments --check "${input}")
  set(expected_exit 1)
  set(expected_output "")
  set(expected_error "${input}:1:5: error: Function \"f\" does not guarantee a return value.\n")
elseif(CASE STREQUAL "check_void_parameter")
  file(WRITE "${input}" "void f(\n  void x) {}\n")
  set(arguments --check "${input}")
  set(expected_exit 1)
  set(expected_output "")
  set(expected_error "${input}:2:3: error: Variables and parameters cannot have type void.\n")
elseif(CASE STREQUAL "check_syntax_error")
  file(WRITE "${input}" "void f() { int x = true; }\nint bad() { return 0 }\n")
  set(arguments --check "${input}")
  set(expected_exit 1)
  set(expected_output "")
  set(expected_error "${input}:2:22: error: Expected \";\" after return value. Received RIGHT_BRACE.\n")
elseif(CASE STREQUAL "check_lexical_error")
  file(WRITE "${input}" "int f() { return true }\n@")
  set(arguments --check "${input}")
  set(expected_exit 1)
  set(expected_output "")
  set(expected_error "${input}:2:1: error: Unexpected character \"@\".\n")
elseif(CASE STREQUAL "check_resolution_error")
  file(WRITE "${input}" "void f() { int x = true; }\nvoid g() { missing; }\n")
  set(arguments --check "${input}")
  set(expected_exit 1)
  set(expected_output "")
  set(expected_error "${input}:2:12: error: Undeclared name \"missing\".\n")
elseif(CASE STREQUAL "check_missing_file")
  file(REMOVE "${input}")
  set(arguments --check "${input}")
  set(expected_exit 1)
  set(expected_output "")
  set(expected_error "${input}: error: Cannot open file.\n")
elseif(CASE STREQUAL "check_missing_argument" OR CASE STREQUAL "check_extra_argument")
  set(arguments --check)
  if(CASE STREQUAL "check_extra_argument")
    set(arguments --check "${input}" extra)
  endif()
  set(expected_exit 1)
  set(expected_output "")
  set(expected_error "minic: error: Expected --check <file>. Use --help for usage.\n")
elseif(CASE STREQUAL "resolve_hello")
  set(input "${SOURCE_DIR}/examples/hello.mc")
  set(arguments --resolve "${input}")
  set(expected_output [=[Resolution
  Scope #0 GLOBAL @1:1
  Scope #1 FUNCTION parent=#0 @3:5
  Symbol #0 FUNCTION "main" scope=#0 @3:5
]=])
elseif(CASE STREQUAL "resolve_scopes" OR CASE STREQUAL "resolve_recursion")
  if(CASE STREQUAL "resolve_scopes")
    set(example scopes)
  else()
    set(example recursion)
  endif()
  set(input "${SOURCE_DIR}/examples/${example}.mc")
  set(arguments --resolve "${input}")
  file(READ "${SOURCE_DIR}/tests/${example}.resolution" expected_output)
elseif(CASE STREQUAL "resolve_empty")
  file(WRITE "${input}" "")
  set(arguments --resolve "${input}")
  set(expected_output "Resolution\n  Scope #0 GLOBAL @1:1\n")
elseif(CASE STREQUAL "resolve_undeclared")
  file(WRITE "${input}" "int ok() {}\nint f() { return missing; }\n")
  set(arguments --resolve "${input}")
  set(expected_exit 1)
  set(expected_output "")
  set(expected_error "${input}:2:18: error: Undeclared name \"missing\".\n")
elseif(CASE STREQUAL "resolve_redeclared")
  file(WRITE "${input}" "int f(int x) {\n  bool x;\n}\n")
  set(arguments --resolve "${input}")
  set(expected_exit 1)
  set(expected_output "")
  set(expected_error "${input}:2:8: error: Name \"x\" is already declared in this scope.\n")
elseif(CASE STREQUAL "resolve_category")
  file(WRITE "${input}" "int f(int f) {\n  f();\n}\n")
  set(arguments --resolve "${input}")
  set(expected_exit 1)
  set(expected_output "")
  set(expected_error "${input}:2:3: error: Name \"f\" does not refer to a function.\n")
elseif(CASE STREQUAL "resolve_syntax_error")
  file(WRITE "${input}" "int f() { missing; }\nint bad() { return 0 }\n")
  set(arguments --resolve "${input}")
  set(expected_exit 1)
  set(expected_output "")
  set(expected_error "${input}:2:22: error: Expected \";\" after return value. Received RIGHT_BRACE.\n")
elseif(CASE STREQUAL "resolve_lexical_error")
  file(WRITE "${input}" "int f() { return missing }\n@")
  set(arguments --resolve "${input}")
  set(expected_exit 1)
  set(expected_output "")
  set(expected_error "${input}:2:1: error: Unexpected character \"@\".\n")
elseif(CASE STREQUAL "resolve_missing_file")
  file(REMOVE "${input}")
  set(arguments --resolve "${input}")
  set(expected_exit 1)
  set(expected_output "")
  set(expected_error "${input}: error: Cannot open file.\n")
elseif(CASE STREQUAL "resolve_missing_argument" OR CASE STREQUAL "resolve_extra_argument")
  set(arguments --resolve)
  if(CASE STREQUAL "resolve_extra_argument")
    set(arguments --resolve "${input}" extra)
  endif()
  set(expected_exit 1)
  set(expected_output "")
  set(expected_error "minic: error: Expected --resolve <file>. Use --help for usage.\n")
elseif(CASE STREQUAL "resolve_names_only")
  file(WRITE "${input}" "void f(void x) { return true + 123456789012345678901234567890; }")
  set(arguments --resolve "${input}")
  set(expected_output [=[Resolution
  Scope #0 GLOBAL @1:1
  Scope #1 FUNCTION parent=#0 @1:6
  Symbol #0 FUNCTION "f" scope=#0 @1:6
  Symbol #1 PARAMETER "x" scope=#1 @1:13
]=])
elseif(CASE STREQUAL "ast_hello" OR CASE STREQUAL "ast_expressions" OR CASE STREQUAL "ast_calls"
       OR CASE STREQUAL "ast_control_flow" OR CASE STREQUAL "ast_language")
  if(CASE STREQUAL "ast_hello")
    set(example hello)
  elseif(CASE STREQUAL "ast_expressions")
    set(example expressions)
  elseif(CASE STREQUAL "ast_calls")
    set(example calls)
  elseif(CASE STREQUAL "ast_control_flow")
    set(example control_flow)
  else()
    set(example lexer)
  endif()
  set(input "${SOURCE_DIR}/examples/${example}.mc")
  set(arguments --ast "${input}")
  file(READ "${SOURCE_DIR}/tests/${example}.ast" expected_output)
elseif(CASE STREQUAL "ast_empty")
  file(WRITE "${input}" "")
  set(arguments --ast "${input}")
  set(expected_output "Program\n")
elseif(CASE STREQUAL "ast_syntax_error")
  file(WRITE "${input}" "int ok() { return 1; }\nint bad() { return 0 }\n")
  set(arguments --ast "${input}")
  set(expected_exit 1)
  set(expected_output "")
  set(expected_error "${input}:2:22: error: Expected \";\" after return value. Received RIGHT_BRACE.\n")
elseif(CASE STREQUAL "ast_lexical_error")
  file(WRITE "${input}" "int f() { return 1 }\n@")
  set(arguments --ast "${input}")
  set(expected_exit 1)
  set(expected_output "")
  set(expected_error "${input}:2:1: error: Unexpected character \"@\".\n")
elseif(CASE STREQUAL "ast_eof_error")
  file(WRITE "${input}" "int f() {\r\n\treturn 0;\r")
  set(arguments --ast "${input}")
  set(expected_exit 1)
  set(expected_output "")
  set(expected_error "${input}:3:1: error: Expected \"}\" after block. Received EOF.\n")
elseif(CASE STREQUAL "tokens_invalid_syntax")
  file(WRITE "${input}" "int x;")
  set(expected_output "1:1 INT \"int\"\n1:5 IDENTIFIER \"x\"\n1:6 SEMICOLON \";\"\n1:7 EOF \"\"\n")
elseif(CASE STREQUAL "ast_missing_file")
  file(REMOVE "${input}")
  set(arguments --ast "${input}")
  set(expected_exit 1)
  set(expected_output "")
  set(expected_error "${input}: error: Cannot open file.\n")
elseif(CASE STREQUAL "ast_missing_argument" OR CASE STREQUAL "ast_extra_argument")
  set(arguments --ast)
  if(CASE STREQUAL "ast_extra_argument")
    set(arguments --ast "${input}" extra)
  endif()
  set(expected_exit 1)
  set(expected_output "")
  set(expected_error "minic: error: Expected --ast <file>. Use --help for usage.\n")
else()
  message(FATAL_ERROR "Unknown CLI test: ${CASE}")
endif()

if(NOT DEFINED arguments)
  set(arguments --tokens "${input}")
endif()

execute_process(
  COMMAND "${MINIC}" ${arguments}
  RESULT_VARIABLE exit_code
  OUTPUT_VARIABLE output
  ERROR_VARIABLE error
)

if(NOT "${exit_code}" STREQUAL "${expected_exit}")
  message(FATAL_ERROR "Expected exit ${expected_exit}, received ${exit_code}.\n${output}${error}")
endif()

if(NOT "${error}" STREQUAL "${expected_error}")
  message(FATAL_ERROR "Expected stderr:\n${expected_error}\nReceived stderr:\n${error}")
endif()

if(CASE STREQUAL "help")
  string(FIND "${output}" "minic --tokens <file>" usage_position)
  if(usage_position EQUAL -1)
    message(FATAL_ERROR "Help does not describe the token command.")
  endif()
  string(FIND "${output}" "minic --ast <file>" ast_usage_position)
  if(ast_usage_position EQUAL -1)
    message(FATAL_ERROR "Help does not describe the AST command.")
  endif()
  string(FIND "${output}" "minic --resolve <file>" resolve_usage_position)
  if(resolve_usage_position EQUAL -1)
    message(FATAL_ERROR "Help does not describe the resolution command.")
  endif()
  string(FIND "${output}" "minic --check <file>" check_usage_position)
  if(check_usage_position EQUAL -1)
    message(FATAL_ERROR "Help does not describe the type-check command.")
  endif()
elseif(NOT "${output}" STREQUAL "${expected_output}")
  message(FATAL_ERROR "Expected stdout:\n${expected_output}\nReceived stdout:\n${output}")
endif()
