; ModuleID = 'examples/llvm/sum.c'
source_filename = "examples/llvm/sum.c"
target datalayout = "e-m:o-i64:64-i128:128-n32:64-S128-Fn32"
target triple = "arm64-apple-macosx15.0.0"

; Function Attrs: noinline nounwind optnone ssp uwtable(sync)
define i32 @sum_next(i32 noundef %limit) #0 {
entry:
  %limit.addr = alloca i32, align 4
  %total = alloca i32, align 4
  %index = alloca i32, align 4
  store i32 %limit, ptr %limit.addr, align 4
  store i32 0, ptr %total, align 4
  store i32 0, ptr %index, align 4
  br label %while.cond

while.cond:                                       ; preds = %while.body, %entry
  %0 = load i32, ptr %index, align 4
  %1 = load i32, ptr %limit.addr, align 4
  %cmp = icmp slt i32 %0, %1
  br i1 %cmp, label %while.body, label %while.end

while.body:                                       ; preds = %while.cond
  %2 = load i32, ptr %total, align 4
  %3 = load i32, ptr %index, align 4
  %call = call i32 @next(i32 noundef %3)
  %add = add nsw i32 %2, %call
  store i32 %add, ptr %total, align 4
  %4 = load i32, ptr %index, align 4
  %add1 = add nsw i32 %4, 1
  store i32 %add1, ptr %index, align 4
  br label %while.cond, !llvm.loop !6

while.end:                                        ; preds = %while.cond
  %5 = load i32, ptr %total, align 4
  ret i32 %5
}

declare i32 @next(i32 noundef) #1

